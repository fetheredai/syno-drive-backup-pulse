# Copy to .env beside docker-compose.yml and fill in.
# Keep this file out of version control — it holds a NAS admin password.

# The published image. GitHub Actions prints this in the run summary after
# each successful publish. Must be lowercase.
PULSE_IMAGE=ghcr.io/<your-github-user>/syno-drive-backup-pulse:latest

# Shown as the heading in the dashboard. Use the client name.
SYNO_NAS_NAME=Acme Co - DS923+

# Service account on THIS NAS. Must be in the administrators group
# (Drive Admin Console data is admin-only) and must not have 2FA enabled.
SYNO_USER=svc-drivemonitor
SYNO_PASS=change-me

# --- everything below is optional; defaults shown -------------------------

# Reaching DSM. The defaults assume the container runs on the NAS it monitors,
# talking to DSM over loopback, which avoids all certificate handling.
#SYNO_HOST=localhost
#SYNO_PORT=5000
#SYNO_HTTPS=false
#SYNO_VERIFY_SSL=false

# History window for the heatmap. Drive Admin Console log retention must be at
# least this long or the calendar will be truncated.
#SYNO_DAYS=90

# How often to collect.
#SYNO_INTERVAL_HOURS=4

# Per-root file counts via File Station DirSize. Walks the folders
# server-side, so it is slow on large datasets. Off by default.
#SYNO_FILE_COUNTS=false

# Port the dashboard listens on. Avoid 5000/5001 (DSM) and 80/443 (Web Station).
#SYNO_WEB_PORT=8477
